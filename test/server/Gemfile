source "https://rubygems.org"

# config/application.rb loads only the Rails frameworks the test server uses.
gem "rails", "~> 8.0"
gem "puma"

# For the AnyCable run. `bundle exec anycable` starts the RPC server that runs
# channel code behind anycable-go.
gem "anycable-rails", "~> 1.6"
gem "redis"   # AnyCable broadcasts to anycable-go through Redis
gem "webrick" # serves the RPC health endpoint that test/run.mjs waits for
gem "sqlite3"  # Active Storage tables for the uploads e2e

# yrby comes from the sibling checkout, so the tests run against its current
# code. Y::ActionCable::Sync is in yrby-rails, which lives in the same repo.
gem "yrby", path: "../../../yrby"
gem "yrby-rails", path: "../../../yrby"
