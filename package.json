{
  "name": "lexxy-realtime",
  "version": "0.5.0",
  "description": "Collaborative editing for the Lexxy editor. Syncs over Yjs through yrby's ActionCable/AnyCable provider, or any Yjs provider.",
  "homepage": "https://github.com/jpcamara/lexxy-realtime#readme",
  "bugs": {
    "url": "https://github.com/jpcamara/lexxy-realtime/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpcamara/lexxy-realtime.git"
  },
  "license": "MIT",
  "author": "JP Camara jp@jpcamara.com",
  "type": "module",
  "main": "dist/lexxy-realtime.js",
  "module": "dist/lexxy-realtime.js",
  "exports": {
    ".": {
      "types": "./types/lexxy-realtime.d.ts",
      "default": "./dist/lexxy-realtime.js"
    }
  },
  "files": [
    "dist",
    "src",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "tag": "latest",
    "access": "public"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "rolldown -c",
    "build:watch": "rolldown --watch -c",
    "build:test": "rolldown -c test/browser/rolldown.config.mjs",
    "test": "node test/run.mjs",
    "test:headless": "node test/run.mjs --headless",
    "test:browser": "node test/run.mjs --browser",
    "build:importmap": "rolldown -c scripts/rolldown.importmap.config.js",
    "test:anycable": "node test/run.mjs --anycable"
  },
  "dependencies": {
    "yrby-client": "^0.5.0"
  },
  "peerDependencies": {
    "@37signals/lexxy": "^0.9.29",
    "@lexical/yjs": "^0.44",
    "lexical": "^0.44",
    "y-protocols": "^1.0",
    "yjs": "^13.6"
  },
  "devDependencies": {
    "@37signals/lexxy": "0.9.29",
    "@anycable/core": "^1.1.1",
    "@anycable/web": "^1.1.1",
    "@lexical/yjs": "^0.44.0",
    "@rails/actioncable": "^8.1.300",
    "@rails/activestorage": "^7.2.302",
    "agent-browser": "^0.28.0",
    "lexical": "^0.44.0",
    "rolldown": "^1.2.1",
    "typescript": "^5.9.0",
    "y-protocols": "*",
    "yjs": "^13.6.0"
  },
  "types": "./types/lexxy-realtime.d.ts",
  "sideEffects": true,
  "keywords": [
    "lexxy",
    "lexical",
    "yjs",
    "crdt",
    "collaborative-editing",
    "realtime",
    "actioncable",
    "anycable",
    "rails",
    "actiontext",
    "yrby"
  ]
}
