<h1><%= @post.title %></h1>

<p>
  Open this page in a second browser to edit together. Each update is saved
  back to <code>@post.body</code> (regular Action Text) as it reaches the
  server.
</p>

<%# turbo_temporary keeps Turbo from caching a snapshot of the live
    editor, which would flash stale content on back/forward navigation. %>
<%= form_with model: @post, data: { turbo_temporary: true } do |form| %>
  <%= form.collaborative_rich_textarea :body %>
<% end %>

<p><%= link_to "View saved post", post_path(@post) %></p>
