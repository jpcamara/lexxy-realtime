# frozen_string_literal: true

source "https://rubygems.org"

gemspec

# Local development uses the sibling yrby checkout when present; CI and
# consumers resolve the released gems.
if File.directory?(File.expand_path("../../yrby", __dir__))
  gem "yrby", path: "../../yrby"
  gem "yrby-rails", path: "../../yrby"
end

group :development, :test do
  gem "minitest"
  gem "rake"
  gem "rubocop", require: false
  gem "rubocop-minitest", require: false
  gem "rubocop-rake", require: false
  gem "sqlite3"
end
